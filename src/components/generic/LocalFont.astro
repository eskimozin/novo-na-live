---
import { join } from "node:path";
import { AstroFont } from "astro-font";

const appDir = process.cwd();
const getFontPath = (name: string) => join(appDir, "public", "fonts", name);
---

<AstroFont
  config={[
    {
      name: "Inter",
      display: "swap",
      selector: ".inter",
      fallback: "sans-serif",
      src: [
        {
          style: "normal",
          path: getFontPath("inter.ttf"),
        },
      ],
    },
    {
      name: "Inter",
      display: "swap",
      selector: ".inter",
      fallback: "sans-serif",
      src: [
        {
          style: "italic",
          path: getFontPath("inter-italic.ttf"),
        },
      ],
    },
    {
      name: "Inter Tight",
      display: "swap",
      selector: ".inter-tight",
      fallback: "sans-serif",
      src: [
        {
          style: "normal",
          path: getFontPath("inter-tight.ttf"),
        },
      ],
    },
    {
      name: "Inter Tight",
      display: "swap",
      selector: ".inter-tight",
      fallback: "sans-serif",
      src: [
        {
          style: "italic",
          path: getFontPath("inter-tight-italic.ttf"),
        },
      ],
    },
    {
      name: "Mozilla Text",
      display: "swap",
      selector: ".mozilla-text",
      fallback: "sans-serif",
      src: [
        {
          style: "normal",
          path: getFontPath("mozilla-text.ttf"),
        },
      ],
    },
  ]}
/>
