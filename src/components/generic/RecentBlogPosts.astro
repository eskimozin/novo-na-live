---
import {getCollection} from 'astro:content';
import BlogList from '../blog/BlogList.astro';
import {Card} from '@eliancodes/brutal-ui';
import {Button} from '@eliancodes/brutal-ui';

interface Props {
  count?: number;
}

const {count} = Astro.props;

const posts = await getCollection('blog').then((posts) =>
  posts.reverse().slice(0, count ?? 3)
);
---

<section class='mt-8'>
  <Card>
    <div class="pb-4">
      <div class='flex justify-between items-start flex-wrap gap-4 mb-8'>
        <h2 class='text-2xl md:text-3xl lg:text-4xl mozilla-text fw-bold'>
          Últimos posts
        </h2>
        <div class='hidden md:block'>
          <Button href='/novo-na-live/blog/'>Ver todos os posts &rarr;</Button>
        </div>
        <div class='block md:hidden'>
          <Button href='/novo-na-live/blog/'>Ver todos os posts</Button>
        </div>
      </div>
      <BlogList posts={posts}/>
    </div>
  </Card>
</section>
