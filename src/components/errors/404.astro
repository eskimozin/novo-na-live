---
import {Button} from '@eliancodes/brutal-ui';
---

<section class='flex flex-col gap-8 justify-between items-start mozilla-text'>
  <h1 class='text-9xl font-bold'>404</h1>
  <div class="flex flex-col gap-8 fw-semibold max-w-[600px] text-balance">
    <h2 class='text-4xl'>Página não encontrada!</h2>
    <p class='text-xl sm:text-4xl lh-1'>Desculpe, mas não localizamos a página que você procurou!</p>
  </div>
  <Button href={"/novo-na-live"}>Ir para a Home</Button>
</section>
