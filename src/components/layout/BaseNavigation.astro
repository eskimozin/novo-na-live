---
import resources from "../../data/resources/resources";

interface Props {
  pageTitle?: string;
}

const navigationItems = [
  {name: 'Home', url: '/novo-na-live/'},
  {name: 'Comece por aqui', url: '/novo-na-live/blog/stay-tuned-to-the-live'},
  {name: 'Figurinhas da live', url: '/novo-na-live/blog/seven-tv'},
  {name: 'Por dentro de tudo', url: '/novo-na-live/blog/follow-on-all-social-networks-pimba'},
];

const socialIcons = [
  {
    name: 'Repositório no Github',
    url: resources["github-repo"],
    icon: 'i-uil-github',
  },
];

const {pageTitle} = Astro.props;
---

<header class='border-b-4 border-black flex justify-between p-6 items-center flex-wrap gap-8'>
  {pageTitle && <h1 class='hidden'>{pageTitle}</h1>}
  <div class="">
    <a href='/novo-na-live' title='Ir para a Home'>
      <p class='inter md:text-xl'><span>Novo na Live</span> <span>🆕</span> </p>
    </a>
  </div>
  <nav class='hidden md:inline-block'>
    <h2 class='hidden'>Navigation</h2>
    <ul class='flex gap-8 inter flex-wrap'>
      {
        navigationItems.map((item) => (
          <li>
            <a
              class='text font-medium hover:text-green hover:underline transition-all duration-150 ease-in-out'
              href={'/novo-na-live/' + item.url}
              title={`Go to ${item.name}`}
            >
              {item.name}
            </a>
          </li>
        ))
      }
      {
        socialIcons.map((item) => (
          <li>
            <a
              href={'/novo-na-live/' + item.url}
              class='hover:text-green hover:underline transition-all duration-150 ease-in-out'
              target='_blank'
              title={`${item.name}`}
            >
              <div class:list={[item.icon, 'w-6 h-6']}/>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <nav class='md:hidden flex inter'>
    <h2 class='hidden'>Mobile Navigation</h2>
    <ul>
      <li><a href='/novo-na-live/'>Comece por aqui</a></li>
    </ul>
  </nav>
</header>
